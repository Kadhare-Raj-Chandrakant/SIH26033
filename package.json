{
  "name": "sih26033",
  "version": "0.1.0",
  "private": true,
  "description": "Agricultural B2B/B2C marketplace — SIH 2026 Problem Statement 26033",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "db:generate": "npm run db:generate -w apps/api && node scripts/sync-prisma-client.mjs",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "db:seed": "node --env-file=apps/api/.env scripts/seed-categories.mjs",
    "db:seed:marketplace": "node scripts/seed-marketplace-csv.mjs",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:reset": "docker compose -f docker/docker-compose.dev.yml down -v && docker compose -f docker/docker-compose.dev.yml up -d",
    "smoke-test": "node scripts/smoke-test.mjs",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0"
  },
  "overrides": {
    "multer": "2.3.0",
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
