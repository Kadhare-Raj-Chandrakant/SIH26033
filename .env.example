# ==============================================================================
# SIH26033 — Root Environment Variables Template
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GIT.
# Copy to .env for local development or set in platform dashboards (Vercel, Render, Neon, Upstash).

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Development: postgresql://user:password@localhost:5432/sih26033?schema=public
# Production (Neon): postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/sih26033?sslmode=require&schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/sih26033?schema=public"

# ------------------------------------------------------------------------------
# 2. Redis (Local / Upstash)
# ------------------------------------------------------------------------------
# Development: redis://localhost:6380
# Production (Upstash): rediss://default:token@sample.upstash.io:6379
REDIS_URL="redis://localhost:6380"

# ------------------------------------------------------------------------------
# 3. Security & Authentication (Argon2 / JWT)
# ------------------------------------------------------------------------------
# In production: must be a cryptographically strong string with >=32 characters
JWT_SECRET="replace-with-at-least-32-characters-cryptographic-secret"
JWT_EXPIRATION="7d"

# ------------------------------------------------------------------------------
# 4. Backend Configuration (NestJS)
# ------------------------------------------------------------------------------
NODE_ENV="development" # Set to 'production' for production builds
API_PORT=4000
PORT=4000 # Injected by Render in production
API_PREFIX="/api/v1"

# CORS Origin: Single origin or comma-separated list of origins. Wildcard '*' is strictly forbidden in production.
# Production Example: https://sih26033.vercel.app,https://sih26033-preview.vercel.app
CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. Frontend Configuration (Next.js / Vercel)
# ------------------------------------------------------------------------------
# Public API URL accessed from browser / SSR
# Production Example: https://sih26033-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# ------------------------------------------------------------------------------
# 6. Cloudinary (Media / Product Image Storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 7. AI/ML Service Boundary (FastAPI / Render)
# ------------------------------------------------------------------------------
# Internal HTTP service URL reachable by the NestJS backend
# Development: http://localhost:8080
# Production Example: https://sih26033-ai.onrender.com
AI_SERVICE_URL="http://localhost:8080"
AI_TIMEOUT_MS=5000
# Internal shared secret for NestJS <-> FastAPI authentication (>=16 characters in production)
AI_INTERNAL_KEY="replace-with-at-least-16-chars-internal-key"

# ------------------------------------------------------------------------------
# 8. Logistics & Payment Provider Adapters
# ------------------------------------------------------------------------------
# Current provider: 'mock' (MockLogisticsProvider with deterministic simulation)
LOGISTICS_PROVIDER="mock"

# ------------------------------------------------------------------------------
# 9. Monitoring & Telemetry (Sentry - Milestone 14 Foundation)
# ------------------------------------------------------------------------------
SENTRY_DSN=""
