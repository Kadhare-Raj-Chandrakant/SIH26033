# ==============================================================================
# SIH26033 — AI/ML Foundation Service (FastAPI) Environment Template
# ==============================================================================
AI_ENVIRONMENT="development" # 'development' | 'production'
AI_HOST="0.0.0.0"
AI_PORT=8080
PORT=8080 # Injected by Render in production
LOG_LEVEL="INFO"

# Internal Authentication Key (must match AI_INTERNAL_KEY in apps/api)
AI_INTERNAL_KEY="replace-with-at-least-16-chars-internal-key"

# CORS configuration for local / internal testing
AI_CORS_ORIGIN="http://localhost:4000,http://localhost:3000"
