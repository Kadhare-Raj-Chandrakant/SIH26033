// SIH26033 — Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  FARMER
  FPO
  BUYER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum BuyerType {
  INDIVIDUAL
  BUSINESS
}

enum SellerType {
  FARMER
  FPO
}

enum AddressType {
  HOME
  BUSINESS
  FARM
  WAREHOUSE
  OTHER
}

enum ProductUnit {
  KG
  GRAM
  QUINTAL
  TONNE
  LITER
  MILLILITER
  PIECE
  DOZEN
  BOX
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
  REJECTED
}

enum OrderStatus {
  PENDING
  NEGOTIATING
  CONFIRMED
  PROCESSING
  READY_FOR_SHIPMENT
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RETURNED
  SETTLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_STATUS_UPDATED
  PAYMENT_RECEIVED
  SYSTEM_ALERT
}

enum ShipmentStatus {
  CREATED
  PICKUP_PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  PRODUCT
  ORDER
  SELLER
}

enum FpoLegalStructure {
  PRODUCER_COMPANY
  COOPERATIVE
  SECTION_8
  OTHER
}

enum FpoStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum FpoMembershipStatus {
  PENDING
  APPROVED
  REJECTED
  LEFT
}

enum FpoListingStatus {
  COMMITTED
  COLLECTED
  AGGREGATED
  SOLD
  CANCELLED
}

enum FpoBatchStatus {
  OPEN
  SEALED
  MATCHED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum FpoBuyRequestStatus {
  OPEN
  PARTIALLY_MATCHED
  FULLY_MATCHED
  CLOSED
  EXPIRED
}

enum FpoSettlementStatus {
  PENDING
  PROCESSING
  DISTRIBUTED
  FAILED
}

enum OrderType {
  INDIVIDUAL
  FPO_BULK
}

// -----------------------------------------------------------------------------
// IDENTITY DOMAIN
// -----------------------------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  mobile       String?       @unique
  passwordHash String
  role         Role
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sellerProfile    SellerProfile?
  buyerProfile     BuyerProfile?
  addresses        Address[]
  notifications    Notification[]
  auditLogs        AuditLog[]         @relation("UserAuditLogs")
  reportsCreated   ModerationReport[] @relation("ReportsCreated")
  reportsReviewed  ModerationReport[] @relation("ReportsReviewed")

  // FPO Relations
  fpoOrganizations  FpoOrganization[]  @relation("FpoAdmin")
  fpoMemberships    FpoMembership[]
  fpoListings       FpoListing[]
  fpoBuyRequests    FpoBuyRequest[]
  fpoSettlements    FpoSettlement[]
  fpoFarmerPayments FpoFarmerPayment[]

  @@index([email])
  @@index([mobile])
  @@index([role])
  @@index([status])
}

model SellerProfile {
  id                 String     @id @default(uuid())
  userId             String     @unique
  user               User       @relation(fields: [userId], references: [id])
  sellerType         SellerType @default(FARMER)
  businessName       String? // Farm name or FPO name
  farmLocation       String?
  verificationStatus String     @default("PENDING")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  products       Product[]
  ordersReceived Order[] // Orders placed by buyers for this seller's products

  @@index([sellerType])
  @@index([verificationStatus])
}

model BuyerProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id])
  buyerType          BuyerType @default(INDIVIDUAL)
  businessName       String?
  verificationStatus String    @default("PENDING")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  ordersPlaced      Order[]
  reviews           Review[]
  cartItems         CartItem[]
  buyerRequirements BuyerRequirement[]
}

model Address {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  type        AddressType @default(HOME)
  name        String
  phone       String
  addressLine String
  city        String
  district    String?
  state       String
  pincode     String
  country     String      @default("India")
  latitude    Float?
  longitude   Float?
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([state, district])
}

// -----------------------------------------------------------------------------
// PRODUCT DOMAIN
// -----------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id         String        @id @default(uuid())
  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id])
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id])

  name        String
  description String
  price       Decimal       @default(0) @db.Decimal(10, 2)
  unit        ProductUnit
  status      ProductStatus @default(ACTIVE)
  location    String? // General location descriptor

  // SIH26033 Demo Dataset Fields
  farmerName                            String?
  farmName                              String?
  state                                 String?
  district                              String?
  marketMandi                           String?
  varietyType                           String?
  sellingUnit                           String?       @default("Rs./Quintal")
  officialMandiModalPriceInr            Decimal?      @db.Decimal(10, 2)
  illustrativeFarmerListingReferenceInr Decimal?      @db.Decimal(10, 2)
  officialPriceDate                     String?
  notes                                 String?
  primaryImage                          String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  images     ProductImage[]
  inventory  Inventory?
  orderItems OrderItem[]
  reviews    Review[]
  cartItems  CartItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([status, createdAt])
  @@index([state])
  @@index([district])
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  cloudinaryId String
  url          String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
}

model Inventory {
  id                String   @id @default(uuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id])
  availableQuantity Decimal  @default(0) @db.Decimal(10, 2)
  reservedQuantity  Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt         DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// ORDER DOMAIN
// -----------------------------------------------------------------------------

model Order {
  id          String        @id @default(uuid())
  orderNumber String        @unique
  buyerId     String
  buyer       BuyerProfile  @relation(fields: [buyerId], references: [id])
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id])
  status      OrderStatus   @default(PENDING)
  orderType   OrderType     @default(INDIVIDUAL)
  totalAmount Decimal       @db.Decimal(10, 2)

  // Historical snapshot of the address
  shippingAddressSnapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  payment  Payment?
  shipment Shipment?

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity   Decimal @db.Decimal(10, 2)
  // Historical price at the time of purchase
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  review Review?

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  providerReference String? // e.g. Razorpay/Stripe transaction ID
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// SOCIAL & ENGAGEMENT DOMAIN
// -----------------------------------------------------------------------------

model Review {
  id          String       @id @default(uuid())
  buyerId     String
  buyer       BuyerProfile @relation(fields: [buyerId], references: [id])
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  orderItemId String       @unique // 1 Review per 1 OrderItem to ensure verified purchase
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])

  rating    Int // e.g., 1 to 5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([buyerId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

// -----------------------------------------------------------------------------
// CART DOMAIN
// -----------------------------------------------------------------------------

model CartItem {
  id        String       @id @default(uuid())
  buyerId   String
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([buyerId, productId])
  @@index([buyerId])
  @@index([productId])
}

// -----------------------------------------------------------------------------
// LOGISTICS DOMAIN
// -----------------------------------------------------------------------------

model Shipment {
  id                  String                 @id @default(uuid())
  orderId             String                 @unique
  order               Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider            String                 // e.g. "MOCK_LOGISTICS"
  providerShipmentId  String?
  trackingNumber      String?                @unique
  status              ShipmentStatus         @default(CREATED)
  estimatedDeliveryAt DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  events              ShipmentTrackingEvent[]

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@index([providerShipmentId])
}

model ShipmentTrackingEvent {
  id              String         @id @default(uuid())
  shipmentId      String
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status          ShipmentStatus
  location        String?
  message         String
  providerEventId String?
  occurredAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())

  @@index([shipmentId])
  @@index([occurredAt])
  @@unique([shipmentId, providerEventId])
}

// -----------------------------------------------------------------------------
// AI / ML FOUNDATION DOMAIN
// -----------------------------------------------------------------------------

model AiPredictionLog {
  id               String   @id @default(uuid())
  modelName        String   // e.g. "price_predictor_baseline", "demand_forecaster_baseline", "crop_recommender_baseline"
  modelVersion     String   // e.g. "1.0.0"
  userId           String?  // Optional user/actor who invoked or received prediction
  inputFeatures    Json     // Key-value map of features used
  predictionOutput Json     // Model response (price, bounds, demand, recommendations)
  actualOutcome    Json?    // Ground-truth transaction outcome recorded after fulfillment
  userDecision     String?  // Action taken by user: "ACCEPTED", "OVERRIDDEN", "REJECTED"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([modelName, modelVersion])
  @@index([userId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// BUYER SOURCING & MATCHING DOMAIN (M10)
// -----------------------------------------------------------------------------

model BuyerRequirement {
  id                String       @id @default(uuid())
  buyerId           String
  buyer             BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  commodity         String       // e.g. "Onion", "Tomato", "Potato", "Wheat", "Rice"
  variety           String?
  requiredQuantity  Decimal      @db.Decimal(10, 2)
  unit              ProductUnit  @default(QUINTAL)
  targetPrice       Decimal?     @db.Decimal(10, 2) // Ceiling price willing to pay per unit
  deliveryLocation  String?      // e.g. "Nashik", "Pune", "Hubballi"
  deliveryLatitude  Float?
  deliveryLongitude Float?
  maxDistanceKm     Float?       // optional fulfillment radius constraint
  status            String       @default("OPEN") // "OPEN", "FULFILLED", "CANCELLED"
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([buyerId])
  @@index([commodity])
  @@index([status])
}

// -----------------------------------------------------------------------------
// ADMIN & MODERATION DOMAIN (M11)
// -----------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  actorUserId   String?
  actor         User?    @relation("UserAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  action        String   // e.g. "USER_STATUS_UPDATE", "SELLER_VERIFICATION", "PRODUCT_MODERATION", "REPORT_RESOLUTION"
  entityType    String   // e.g. "USER", "SELLER", "PRODUCT", "ORDER", "REPORT"
  entityId      String
  previousState Json?
  newState      Json?
  reason        String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model ModerationReport {
  id               String           @id @default(uuid())
  reporterUserId   String
  reporter         User             @relation("ReportsCreated", fields: [reporterUserId], references: [id], onDelete: Cascade)
  targetType       ReportTargetType
  targetId         String
  reason           String
  description      String?
  status           ReportStatus     @default(OPEN)
  reviewedByUserId String?
  reviewedBy       User?            @relation("ReportsReviewed", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  resolutionNotes  String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([reporterUserId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// FPO (FARMER PRODUCER ORGANISATION) AGGREGATION DOMAIN
// -----------------------------------------------------------------------------

model FpoOrganization {
  id                 String            @id @default(uuid())
  name               String
  registrationNumber String            @unique
  legalStructure     FpoLegalStructure
  status             FpoStatus         @default(PENDING_VERIFICATION)
  registrationDate   DateTime?
  state              String
  district           String
  address            String
  pincode            String
  contactEmail       String
  contactPhone       String
  bankAccountNumber  String?
  ifscCode           String?
  bankName           String?
  description        String?
  logoUrl            String?
  adminId            String
  admin              User              @relation("FpoAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  memberships FpoMembership[]
  listings    FpoListing[]
  batches     FpoAggregationBatch[]
  buyRequests FpoBuyRequest[]
  settlements FpoSettlement[]

  @@index([state, district])
  @@index([status])
}

model FpoMembership {
  id              String              @id @default(uuid())
  fpoId           String
  fpo             FpoOrganization     @relation(fields: [fpoId], references: [id], onDelete: Cascade)
  farmerId        String
  farmer          User                @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  status          FpoMembershipStatus @default(PENDING)
  shareCapital    Decimal?            @db.Decimal(10, 2)
  joinedAt        DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([fpoId, farmerId])
  @@index([farmerId, status])
  @@index([fpoId])
}

model FpoListing {
  id                  String               @id @default(uuid())
  fpoId               String
  fpo                 FpoOrganization      @relation(fields: [fpoId], references: [id], onDelete: Cascade)
  farmerId            String
  farmer              User                 @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  commodity           String
  quantityQuintals    Decimal              @db.Decimal(10, 2)
  qualityGrade        String?
  expectedHarvestDate DateTime?
  actualCollectedQty  Decimal?             @db.Decimal(10, 2)
  notes               String?
  status              FpoListingStatus     @default(COMMITTED)
  batchId             String?
  batch               FpoAggregationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  payments            FpoFarmerPayment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([fpoId, status])
  @@index([farmerId])
  @@index([commodity])
}

model FpoAggregationBatch {
  id            String          @id @default(uuid())
  fpoId         String
  fpo           FpoOrganization @relation(fields: [fpoId], references: [id], onDelete: Cascade)
  batchNumber   String          @unique
  commodity     String
  totalQuantity Decimal         @db.Decimal(10, 2)
  qualityGrade  String?
  status        FpoBatchStatus  @default(OPEN)
  sealedAt      DateTime?
  buyRequestId  String?
  buyRequest    FpoBuyRequest?  @relation(fields: [buyRequestId], references: [id], onDelete: SetNull)
  orderId       String?
  listings      FpoListing[]
  settlements   FpoSettlement[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([fpoId, status])
  @@index([commodity, status])
}

model FpoBuyRequest {
  id                  String              @id @default(uuid())
  buyerId             String
  buyer               User                @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  fpoId               String?
  fpo                 FpoOrganization?    @relation(fields: [fpoId], references: [id], onDelete: SetNull)
  commodity           String
  requiredQuantity    Decimal             @db.Decimal(10, 2)
  filledQuantity      Decimal             @default(0) @db.Decimal(10, 2)
  targetPrice         Decimal?            @db.Decimal(10, 2)
  deliveryCity        String?
  maxDistanceKm       Float?
  qualityRequirements String?
  notes               String?
  status              FpoBuyRequestStatus @default(OPEN)
  expiresAt           DateTime?
  batches             FpoAggregationBatch[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, commodity])
  @@index([buyerId])
}

model FpoSettlement {
  id               String              @id @default(uuid())
  fpoId            String
  fpo              FpoOrganization     @relation(fields: [fpoId], references: [id], onDelete: Cascade)
  adminId          String?
  admin            User?               @relation(fields: [adminId], references: [id], onDelete: SetNull)
  orderId          String              @unique
  batchId          String
  batch            FpoAggregationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  grossAmount      Decimal             @db.Decimal(10, 2)
  fpoCommission    Decimal             @db.Decimal(10, 2)
  transportCost    Decimal             @db.Decimal(10, 2)
  handlingCost     Decimal             @db.Decimal(10, 2)
  otherDeductions  Decimal             @default(0) @db.Decimal(10, 2)
  netDistributable Decimal             @db.Decimal(10, 2)
  status           FpoSettlementStatus @default(PENDING)
  distributedAt    DateTime?
  farmerPayments   FpoFarmerPayment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([fpoId])
  @@index([batchId])
}

model FpoFarmerPayment {
  id             String              @id @default(uuid())
  settlementId   String
  settlement     FpoSettlement       @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  farmerId       String
  farmer         User                @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  listingId      String
  listing        FpoListing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity       Decimal             @db.Decimal(10, 2)
  ratePerQuintal Decimal             @db.Decimal(10, 2)
  grossAmount    Decimal             @db.Decimal(10, 2)
  deductions     Decimal             @default(0) @db.Decimal(10, 2)
  netAmount      Decimal             @db.Decimal(10, 2)
  status         FpoSettlementStatus @default(PENDING)
  paidAt         DateTime?
  transactionId  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([settlementId])
  @@index([farmerId])
  @@index([listingId])
}
