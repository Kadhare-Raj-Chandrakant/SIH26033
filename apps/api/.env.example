# ==============================================================================
# SIH26033 — Backend API (NestJS) Environment Template
# ==============================================================================
NODE_ENV="development" # 'development' | 'production' | 'test'
API_PORT=4000
PORT=4000

# PostgreSQL Connection (Neon in production)
DATABASE_URL="postgresql://user:password@localhost:5432/sih26033?schema=public"

# Redis Connection (Upstash in production, supports rediss:// TLS)
REDIS_URL="redis://localhost:6380"

# JWT Authentication
JWT_SECRET="replace-with-at-least-32-characters-cryptographic-secret"
JWT_EXPIRATION="7d"

# CORS Allowed Origin(s) — comma-separated if multiple
CORS_ORIGIN="http://localhost:3000"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AI Service Integration
AI_SERVICE_URL="http://localhost:8080"
AI_TIMEOUT_MS=5000
AI_INTERNAL_KEY="replace-with-at-least-16-chars-internal-key"

# Logistics Provider Adapter
LOGISTICS_PROVIDER="mock"
